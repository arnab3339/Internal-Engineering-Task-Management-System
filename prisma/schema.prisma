generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ARCHIVED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  CHANGES_REQUESTED
  COMPLETED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ReviewDecision {
  APPROVED
  CHANGES_REQUESTED
}

model Role {
  id          BigInt  @id @default(autoincrement())
  name        String  @unique @db.VarChar(50)
  description String? @db.VarChar(255)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users User[]

  @@map("roles")
}

model User {
  id           BigInt @id @default(autoincrement())
  fullName     String @map("full_name") @db.VarChar(150)
  email        String @unique @db.VarChar(255)
  passwordHash String @map("password_hash") @db.VarChar(255)

  roleId BigInt @map("role_id")

  isActive           Boolean @default(true) @map("is_active")
  mustChangePassword Boolean @default(false) @map("must_change_password")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  role     Role      @relation(fields: [roleId], references: [id])
  projects Project[]
  tasks    Task[]

  projectMemberships  ProjectMember[]  @relation("ProjectMemberUser")
  addedProjectMembers ProjectMember[]  @relation("ProjectMemberAddedBy")
  taskAssignments     TaskAssignment[] @relation("TaskAssignmentDeveloper")
  assignedTasks       TaskAssignment[] @relation("TaskAssignmentAssignedBy")
  submissions Submission[]
  reviews Review[]
  @@map("users")
}

model ProjectMember {
  id BigInt @id @default(autoincrement())

  projectId BigInt @map("project_id")
  userId    BigInt @map("user_id")
  addedBy   BigInt @map("added_by")

  joinedAt  DateTime  @default(now()) @map("joined_at")
  removedAt DateTime? @map("removed_at")

  project     Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user        User    @relation("ProjectMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  addedByUser User    @relation("ProjectMemberAddedBy", fields: [addedBy], references: [id])

  @@index([projectId, userId, removedAt])
  @@map("project_members")
}

model Project {
  id            BigInt        @id @default(autoincrement())
  name          String        @db.VarChar(200)
  description   String?       @db.Text
  status        ProjectStatus @default(PLANNING)
  createdBy     BigInt        @map("created_by")
  startDate     DateTime?     @map("start_date") @db.Date
  targetEndDate DateTime?     @map("target_end_date") @db.Date
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  creator User            @relation(fields: [createdBy], references: [id])
  members ProjectMember[]
  tasks   Task[]

  @@map("projects")
}

model Task {
  id                 BigInt       @id @default(autoincrement())
  projectId          BigInt       @map("project_id")
  title              String       @db.VarChar(255)
  description        String?      @db.Text
  acceptanceCriteria String?      @map("acceptance_criteria") @db.Text
  status             TaskStatus   @default(TODO)
  priority           TaskPriority @default(MEDIUM)
  createdBy          BigInt       @map("created_by")
  deadline           DateTime?
  createdAt          DateTime     @default(now()) @map("created_at")
  updatedAt          DateTime     @updatedAt @map("updated_at")
  completedAt        DateTime?    @map("completed_at")

  creator     User             @relation(fields: [createdBy], references: [id])
  project     Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignments TaskAssignment[]
  submissions Submission[]

  @@map("tasks")
}

model UnassignmentReason {
  id                 BigInt  @id @default(autoincrement())
  code               String  @unique @db.VarChar(100)
  label              String  @db.VarChar(255)
  affectsPerformance Boolean @map("affects_performance")

  assignments TaskAssignment[]

  @@map("unassignment_reasons")
}

model TaskAssignment {
  id                   BigInt    @id @default(autoincrement())
  taskId               BigInt    @map("task_id")
  developerId          BigInt    @map("developer_id")
  assignedBy           BigInt    @map("assigned_by")
  assignedAt           DateTime  @default(now()) @map("assigned_at")
  unassignedAt         DateTime? @map("unassigned_at")
  unassignmentReasonId BigInt?   @map("unassignment_reason_id")
  unassignmentNote     String?   @db.VarChar(500)
  isCurrent            Boolean   @map("is_current")

  task               Task                @relation(fields: [taskId], references: [id])
  developer          User                @relation("TaskAssignmentDeveloper", fields: [developerId], references: [id])
  assignedByUser     User                @relation("TaskAssignmentAssignedBy", fields: [assignedBy], references: [id])
  unassignmentReason UnassignmentReason? @relation(fields: [unassignmentReasonId], references: [id])
  submissions Submission[]

  @@map("task_assignments")
}

model Submission {
  id               BigInt   @id @default(autoincrement())
  taskId           BigInt   @map("task_id")
  submittedBy      BigInt   @map("submitted_by")
  assignmentId     BigInt   @map("assignment_id")
  submissionNumber Int      @map("submission_number")
  prUrl            String   @map("pr_url") @db.VarChar(500)
  notes            String?  @db.Text
  submittedAt      DateTime @default(now()) @map("submitted_at")

  task       Task           @relation(fields: [taskId], references: [id])
  submittedByUser User      @relation(fields: [submittedBy], references: [id])
  assignment TaskAssignment @relation(fields: [assignmentId], references: [id])
  review Review?
  @@unique([taskId, submissionNumber])
  @@map("submissions")
}

model Review {

  id                         BigInt         @id @default(autoincrement())

  submissionId               BigInt         @unique @map("submission_id")
  reviewedBy                 BigInt         @map("reviewed_by")
  requirementAnalysisScore   Int            @map("requirement_analysis_score") @db.TinyInt
  codeQualityScore           Int            @map("code_quality_score") @db.TinyInt
  codeCorrectnessScore       Int            @map("code_correctness_score") @db.TinyInt
  testingScore               Int            @map("testing_score") @db.TinyInt
  deliveryTimingScore        Int            @map("delivery_timing_score") @db.TinyInt
  prCommitQualityScore       Int            @map("pr_commit_quality_score") @db.TinyInt
  feedback                   String?        @db.Text
  decision                   ReviewDecision
  reviewedAt                 DateTime       @default(now()) @map("reviewed_at")

  submission                 Submission     @relation(fields: [submissionId], references: [id])
  reviewedByUser             User           @relation(fields: [reviewedBy], references: [id])

  @@map("reviews")

}